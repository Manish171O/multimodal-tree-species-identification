{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. Generate synthetic data",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/make_synthetic_data.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "2. Inspect data",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/inspect_data.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "3. Evaluate shipped final model",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/evaluate.py",
      "args": [
        "--checkpoint",
        "results/final_model_best.pt"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "4. Train final model",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/train.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "4b. Train final model (NVIDIA GPU, mixed precision)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/train.py",
      "args": [
        "--set",
        "train.amp=true"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "5. Evaluate my trained model",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/evaluate.py",
      "args": [
        "--checkpoint",
        "outputs/best.pt"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "6. All experiments (quick check, ~5 min)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_experiments.py",
      "args": [
        "--quick",
        "--out",
        "outputs/exp_quick"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "7. All experiments (full, hours)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_experiments.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "8. Make real-species dataset",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/make_real_species_data.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "9. PREDICT: 8 random test crowns (opens report)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/predict.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "9b. PREDICT: with LiDAR missing",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/predict.py",
      "args": [
        "--drop",
        "lidar",
        "--out",
        "predictions_no_lidar"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "9c. PREDICT: your own files (examples/crown_1)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/predict.py",
      "args": [
        "--rgb",
        "examples/crown_1_rgb.png",
        "--hsi",
        "examples/crown_1_hsi.npy",
        "--lidar",
        "examples/crown_1_lidar.npy",
        "--out",
        "predictions_custom"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "10. Train real-species model",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/train.py",
      "args": [
        "--config",
        "configs/real_species.yaml"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "9d. PREDICT: one crown of every species (20 cards)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/predict.py",
      "args": [
        "--per-species",
        "1",
        "--out",
        "predictions_all_species"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "11. Evaluate real-species model on all 301 test crowns",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/evaluate.py",
      "args": [
        "--checkpoint",
        "results/real_species_model.pt",
        "--out",
        "predictions/evaluation"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}